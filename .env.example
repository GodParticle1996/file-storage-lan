# --- Vixi environment configuration ---
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- App ---
NODE_ENV=development
PORT=8080
CLIENT_ORIGIN=http://vixi.local
# Used for invite/share URL generation. Must be reachable from LAN.
PUBLIC_BASE_URL=http://vixi.local

# --- Auth ---
# 32+ random chars. Generate with: openssl rand -hex 48
JWT_SECRET=replace_me_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d
INVITE_EXPIRES_DAYS=7

# --- Admin bootstrap (used ONCE on first startup if no users exist) ---
ADMIN_EMAIL=admin@vixi.local
ADMIN_PASSWORD=change_me_on_first_login

# --- MongoDB Atlas (free M0) ---
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=VixiLocalNetwork
MONGODB_DB=vixi

# --- Cloudflare R2 (S3-compatible) ---
# From Cloudflare dashboard: R2 > your account > API tokens > "Manage R2 API Tokens"
R2_ACCOUNT_ID=your_cloudflare_account_id
# Bucket settings
R2_BUCKET=vixi
R2_REGION=auto
# API token with Object Read & Write on the bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Public endpoint for browser uploads (R2 bucket subdomain or custom domain)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
